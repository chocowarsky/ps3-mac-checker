# udev rules to allow non-root read/write access to PS3 DualShock 3 / Sixaxis controllers
# Allows reading and writing HID feature reports (0xF2 / 0xF5) without sudo prompts on Ubuntu, Fedora, Debian, Arch, etc.
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0268", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", ATTR{idProduct}=="0268", MODE="0666", TAG+="uaccess"
